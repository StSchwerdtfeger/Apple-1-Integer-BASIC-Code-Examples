# Calculating the factorial of an integer number:
# Recursive loop, since P = 1 is an initial definition,
# after which within the for loop the previous P, called from 
# the right side of the (syntax) equation P= P * I is called
# with the rising (integer steps!) factor I. See below for a 
# and wise calculation: 
 
10 LET P = 1
20 FOR I = 1 TO 5
30 LET P = P * I
40 NEXT I
50 PRINT "5! = "; P
60 END

# Output with text comment string "5! = !":
5! = 120


# HAND-WISE ALGORITHM:

INITIAL P:
P = 1 
# FIRST  ITERATION: I = 1
P = (P=1) * (I=1) = 1

# SECOND ITERATION: I = 2 and P = 1 (again, since 1*1=1)
P = (P=1) * (I=2) = 2

# THIRD  ITERATION: I = 3
P = (P=2) * (I=3) = 6

# FORTH  ITERATION: I = 4
P = (P=6) * (I=4) = 24

# FIVE   ITERATION: I = 5
P = (P=24) * (I=5) = 120

# => 5! = 120


# Bubble sort algorithm. 

Line 10 defines the length of an array. 
10 DIM A(10)
20 FOR I = 1 TO 10
30 LET A(I) = 11 - I
40 NEXT I
50 PRINT "BEFORE:"
60 FOR I = 1 TO 10
70 PRINT A(I)
80 NEXT I
90 REM BUBBLE SORT
100 FOR I = 1 TO 9
110 FOR J = 1 TO 9
120 IF A(J) <= A(J+1) THEN 150
130 LET T = A(J): LET A(J) = A(J+1): LET A(J+1) = T
150 NEXT J
160 NEXT I
170 PRINT "AFTER:"
180 FOR I = 1 TO 10
190 PRINT A(I)
200 NEXT I
210 END

