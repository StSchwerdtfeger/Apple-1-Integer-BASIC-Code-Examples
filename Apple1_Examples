# Sierpinski triangle (right-skewed version):
# Note that the line 170 just says PRINT
# since it then plots an empty line. Lines
# 90, 130 and 150 end with a Semicolon so that
# "*" or " " get printed in the same (!) line.
# 170 is then used to go the a next line...

10 LET N = 16
20 DIM P(N+1)
30 FOR K = 1 TO N+1
40 LET P(K) = 0
50 NEXT K
60 LET P(1) = 1
70 FOR R = 0 TO N-1
80 FOR K = 1 TO N-1-R
90 PRINT " ";
100 NEXT K
110 FOR K = 0 TO R
120 IF P(K+1) = 1 THEN 150
130 PRINT " ";
140 GOTO 160
150 PRINT "*";
160 NEXT K
170 PRINT
180 FOR M = R+2 TO 2 STEP -1
190 LET P(M) = (P(M) + P(M-1)) MOD 2
200 NEXT M
210 NEXT R
220 END

# OUTPUT:
              *
             **
            * *
           ****
          *   *
         **  **
        * * * *
       ********
      *       *
     **      **
    * *     * *
   ****    ****
  *   *   *   *
 **  **  **  **
* * * * * * * *
****************



# Integer log base 2 of N = 2:
# Essentially it count how many times N can be halfed, until it drops below 2:

# 10-30 initializes vaiables N, L and X, which is at first a duplicate of N
# 40 for the case that X (which is essentially N) is not below 2 it jumps
# the next line, else it moves to 80 to print the current X. The current
# X is calculated on 50, where X is divided by 2. Then the next line 70
# moves the process back to checking the condition IF X < 2...
# For the example below, where N = 2, the log2 will be 1...

10 LET N = 2
20 LET L = 0
30 LET X = N
40 IF X < 2 THEN 80
50 LET X = X / 2
60 LET L = L + 1
70 GOTO 40
80 PRINT "LOG2("; N; ") = "; L
90 END

# Output (Note log2(100) = 6.6438 though here it will be rounded to 6 (via a floor()/truncate() equivalent!!):
LOG2(2) = 1


# Quadratic formula  

# Note that Apple 1 integer BASIC does not include a SQRT() function, so there is a work around
# for that in the code below in order to calculate the roots. 
# Line 50 stops the algorithm in case its negative (imaginary number would be needed here).
 

10 LET A = 2
20 LET B = 4
30 LET C = 2
40 LET D = B*B - 4*A*C
50 IF D < 0 THEN 200
60 REM INTEGER SQUARE ROOT OF D
70 LET R = 0
80 IF (R+1)*(R+1) > D THEN 110
90 LET R = R + 1
100 GOTO 80
110 LET X1 = (-B + R) / (2*A)
120 LET X2 = (-B - R) / (2*A)
130 PRINT "D = "; D
140 PRINT "SQRT(D) = "; R; " (INTEGER PART)"
150 PRINT "X1 = "; X1
160 PRINT "X2 = "; X2
170 END
200 PRINT "NO REAL ROOTS (D < 0)"
210 END

# Output will look like this:
SQRT(D) = 0 (INTEGER PART)
X1 = -1
X2 = -1


